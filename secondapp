import sqlite3


def print_all_foods():
    db = sqlite3.connect('xxbestfoods.db')
    cursor = db.cursor()
    sql = 'SELECT * FROM best_foods;'
    cursor.execute(sql)
    results = cursor.fetchall()
    print("""
          Food Name                       Country of origin          Ranking
          """)
    for food in results:
        print(f"{food[1]:<34}{food[2]:<28}{food[3]}\n")
    db.close()


def print_foods_and_country():
    db = sqlite3.connect('xxbestfoods.db')
    cursor = db.cursor()
    sql = 'SELECT * FROM best_foods;'
    cursor.execute(sql)
    results = cursor.fetchall()
    print("\nFood Name                       Country of origin\n")
    for food in results:
        print(f"{food[1]:<34}{food[2]:<28}\n")
    db.close()


def print_foods_and_ranking():
    db = sqlite3.connect('xxbestfoods.db')
    cursor = db.cursor()
    sql = 'SELECT * FROM best_foods;'
    cursor.execute(sql)
    results = cursor.fetchall()
    print("\nFood Name                       Ranking\n")
    for food in results:
        print(f"{food[1]:<34}{food[3]}\n")
    db.close()


print_all_foods()
while True:
    user_input = input(
        """What would you like to do?
        1. Print all foods.
        2. Print all foods and their country of origin.
        3. Print all foods and their ranking.
        4. Exit.\n""")
    if user_input == "1":
        print_all_foods()
    elif user_input == "2":
        print_foods_and_country()
    elif user_input == "3":
        print_foods_and_ranking()
    elif user_input == "4":
        break
    else:
        print("That was not an option.")
