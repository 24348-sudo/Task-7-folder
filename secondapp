import sqlite3


def print_all_foods():
    db = sqlite3.connect('xxbestfoods.db')
    cursor = db.cursor()
    sql = 'SELECT * FROM best_foods;'
    cursor.execute(sql)
    results = cursor.fetchall()
    print("Food Name                       Country of origin          Ranking")
    for food in results:
        print(f"{food[1]:<34}{food[2]:<28}{food[3]}")
    db.close()


print_all_foods()
